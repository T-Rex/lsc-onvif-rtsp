# Settings for start.sh / stop.sh / status.sh (KEY=value, no spaces).

# Seconds start.sh waits for an IPv4 address on the interface.
WAIT_IP_SECS=60

# 0: logs go to the SD card (logs/ next to start.sh).
# 1: logs stay in RAM under /tmp/onvif/log (no SD card writes; lost on reboot).
LOG_IN_RAM=0

# wsd_simple_server log level, 0 (fatal errors only) .. 5 (trace).
WSD_DEBUG=0

# 1: BusyBox httpd logs every request to logs/httpd.log.
HTTPD_VERBOSE=0

# start.sh refuses to start if /tmp has less free space than this (KB).
MIN_TMP_FREE_KB=2048
