# onvif_ptz.env - onvif_ptz_bridge 1.4 runtime configuration (optional).
# Copy to onvif_ptz.env next to this file; enable-ptz.sh sources it and exports
# these to the bridge daemon. ALL values are optional; an absent file == the
# compat profile, which is byte-for-byte the proven 1.3 behaviour.
#
# BusyBox /bin/sh syntax (KEY=value, no spaces). No tr/gzip/python needed.

# ---- speed profile -------------------------------------------------------
# compat  : default. NEVER issues SET_SPEED; ONVIF velocity -> duty cycle (1.3).
# hw      : apply the per-axis speed_step below via the verified SET_SPEED ioctl,
#           restore 600 on release. speed_step changes never restart a move.
# exp750  : shortcut for hw with step 750 (the only tested experimental value).
#PTZ_SPEED_PROFILE=compat

# Per-axis target speed_step (Hz) when profile=hw. Default 600.
#PTZ_PAN_SPEED_STEP=600
#PTZ_TILT_SPEED_STEP=600

# Per-axis hard clamp. The build also enforces a ceiling of 750; the factory
# tracking value 800 is deliberately NOT selectable here.
#PTZ_PAN_SPEED_MAX=750
#PTZ_TILT_SPEED_MAX=750

# ---- scheduler / safety (rarely changed) --------------------------------
#PTZ_TICK_MS=20
#PTZ_MAX_PER_TICK=12
#PTZ_MARGIN=32
#PTZ_DEF_TIMEOUT_MS=10000
#PTZ_HARD_TIMEOUT_MS=60000
