+/* --- PTZ ContinuousMove Timeout support (added by ptz-smooth upgrade) --- */
+#define PTZ_TIMEOUT_DEFAULT_MS 10000L
+#define PTZ_TIMEOUT_MAX_MS     60000L
+
+/* Parse an ONVIF xs:duration (e.g. PT5S, PT0.5S, PT1M30S) to milliseconds.
+ * NULL/empty -> def_ms; malformed -> def_ms; clamped to [0, max_ms]. Only
+ * the parsed numeric result is used; the raw string never reaches a shell. */
+static long parse_onvif_duration_ms(const char *str, long def_ms, long max_ms)
+{
+    const char *p = str;
+    double total = 0.0;
+    int in_time = 0, saw_field = 0, neg = 0;
+    long ms;
+
+    if (p == NULL || *p == 0)
+        return def_ms;
+    if (*p == '-') { neg = 1; p++; }
+    if (*p != 'P')
+        return def_ms;
+    p++;
+    while (*p) {
+        char *end;
+        double val;
+        if (*p == 'T') { in_time = 1; p++; continue; }
+        val = strtod(p, &end);
+        if (end == p)
+            return def_ms;
+        switch (*end) {
+            case 'H': total += val * 3600.0; break;
+            case 'M': total += in_time ? val * 60.0 : val * 2592000.0; break;
+            case 'S': total += val; break;
+            case 'D': total += val * 86400.0; break;
+            case 'W': total += val * 604800.0; break;
+            case 'Y': total += val * 31536000.0; break;
+            default: return def_ms;
+        }
+        saw_field = 1;
+        p = end + 1;
+    }
+    if (!saw_field)
+        return def_ms;
+    if (neg)
+        return 0;
+    ms = (long)(total * 1000.0 + 0.5);
+    if (ms < 0) ms = 0;
+    if (ms > max_ms) ms = max_ms;
+    return ms;
+}
 
